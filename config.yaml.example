# Main Manifold runtime configuration.
#
# This file is the primary source of truth for runtime behavior.
# Environment variables are still supported, but only because YAML values can
# reference them via ${VAR}. Use example.env for the full set of variables that
# this example references.
#
# Config loading notes:
# - Manifold reads config.yaml or config.yml from the working directory.
# - ${VAR} references are expanded from the shell environment and .env.

# Workspace root used by the agent and by relative project paths. In Docker,
# docker-compose.yml normally sets WORKDIR in .env and mounts it into the app.
# This path is where all Projects will be created under. Recommend to create a new
# folder in your user home directory `~/manifold-projects`
workdir: "${WORKDIR}"

promptOverrides:
  # Empty fields use Manifold's built-in defaults from internal/agent/prompts.
  # These fields replace shared built-in prompt blocks used by orchestrators
  # and specialists when their matching feature is enabled.
  baseSystem: ""
  memoryInstructions: ""
  toolDiscoveryInstructions: ""
  skillDiscoveryInstructions: ""

# Agent runtime limits.
# maxSteps caps reasoning/tool loop iterations. The timeout values are wall-clock
# bounds in seconds; set them to 0 to disable global runtime timeouts.
maxSteps: 1000
maxToolParallelism: 0 # 0=unbounded, 1=sequential, >1=capped
outputTruncateBytes: 131072
agentRunTimeoutSeconds: 0
streamRunTimeoutSeconds: 0
workflowTimeoutSeconds: 0

# Logging.
logPath: manifold.log
# logLevel is passed to zerolog/slog integrations. Common values: debug, info,
# warn, error. Payload logging can include sensitive prompt/tool content.
logLevel: info
logPayloads: false
logRawPrompts: false

# Tool execution policy.
# enableTools globally controls whether the orchestrator receives tool schemas.
enableTools: true
# requestInfoEnabled lets interactive runs ask the user for missing inputs.
requestInfoEnabled: true
# When enabled, allowTools is the bootstrap set and agents can discover
# additional registered tools at runtime via tool_search.
autoDiscover: false
# Caps how many non-bootstrap tools a single run may add when autoDiscover is on.
maxDiscoveredTools: 12
allowTools:
  - run_cli
  - describe_image
  - web_fetch

exec:
  # Default timeout for one-shot command execution.
  maxCommandSeconds: 1200
  # Terminal sessions are long-lived PTY sessions used by terminal_* tools.
  maxTerminalSessions: 8
  maxTerminalRuntimeSeconds: 1200
  terminalIdleTTLSeconds: 1800
  terminalOutputBufferBytes: 262144
  sandbox:
    # enabled/failIfUnavailable are pointers internally so omitted values can
    # default to true. Keep explicit values here for predictable installs.
    enabled: true
    failIfUnavailable: true
    # Extra host paths the command sandbox may read but not write. Absolute
    # paths are used as-is; relative paths resolve under the active workspace.
    # macOS Cargo/LibreSSL may need /private/etc/ssl to read openssl.cnf.
    readPaths:
      - /private/etc/ssl
    network:
      # Network is blocked inside the command sandbox unless enabled here.
      enabled: false
      allowedDomains: []
  commandRules:
    # Rules are matched against argv tokens. decision is allow, ask, or deny.
    - id: allow-go
      decision: allow
      pattern: ["go"]
      contexts: ["cli", "terminal"]
      justification: "Go tooling is allowed inside the workspace sandbox."
    - id: allow-git
      decision: allow
      pattern: ["git"]
      contexts: ["cli", "terminal"]
      justification: "Git inspection is allowed inside the workspace sandbox."
  blockBinaries:
    - rm
    - sudo
    - chown
    - chmod
    - dd
    - mkfs
    - mount
    - umount

# Chat summarization. This LLM is independent from the primary runtime LLM so
# plain text summaries remain portable when switching providers.
summary:
  enabled: true
  # Maximum time a single summary-model request may block a chat request.
  # Set to 0 to use the built-in default.
  callTimeoutSeconds: 120
  contextWindowTokens: 32000
  # Optional global plain-text summary trigger budget. Set to 0 to fall back
  # to the configured summary model's context size.
  plainTextContextWindowTokens: 0
  reserveBufferTokens: 25000
  minKeepLastMessages: 4
  maxKeepLastMessages: 12
  maxSummaryChunkTokens: 4096
  llm_client:
    # openai | anthropic | google | local
    provider: openai
    openai:
      apiKey: "${OPENAI_API_KEY}"
      baseURL: https://api.openai.com/v1
      model: gpt-5-nano
      api: completions
      extraHeaders: {}
      extraParams: {}
      logPayloads: false
    # anthropic:
    #   apiKey: "${ANTHROPIC_API_KEY}"
    #   model: claude-sonnet-4-6
    #   baseURL: https://api.anthropic.com
    #   maxTokens: 4096
    #   extraParams: {}
    #   promptCache:
    #     enabled: true
    #     cacheSystem: true
    #     cacheTools: true
    #     cacheMessages: false
    # google:
    #   apiKey: "${GOOGLE_LLM_API_KEY}"
    #   model: gemini-2.5-flash
    #   baseURL: https://generativelanguage.googleapis.com/
    #   timeoutSeconds: 30
    #   contextCache:
    #     enabled: false
    #     cachedContent: ""
    #     autoCreate: false
    #     ttlSeconds: 3600
    #     cacheSystem: true
    #     cacheTools: true
    #     displayName: manifold-summary
    #   extraParams: {}

# Primary LLM provider configuration.
llm_client:
  # openai | anthropic | google | local
  provider: openai
  openai:
    apiKey: "${OPENAI_API_KEY}"
    baseURL: https://api.openai.com/v1
    model: gpt-5-mini
    # Optional legacy summary aliases. Prefer summary.llm_client for new config.
    summaryModel: gpt-5-nano
    summaryBaseURL: https://api.openai.com/v1
    # completions | responses
    api: completions
    extraHeaders: {}
    extraParams:
      parallel_tool_calls: true
      # OpenAI prompt caching is automatic for long stable prefixes. Keep
      # system/tool/schema text first and dynamic memory/user text last.
      prompt_cache_key: manifold-local-agent
      prompt_cache_retention: in_memory # or 24h on supported OpenAI models
      reasoning_effort: medium
    # Per-client payload logging. This is separate from the top-level
    # logPayloads switch and should remain false unless debugging requests.
    logPayloads: false
  anthropic:
    apiKey: "${ANTHROPIC_API_KEY}"
    model: claude-sonnet-4-6
    baseURL: https://api.anthropic.com
    maxTokens: 4096
    extraParams: {}
    promptCache:
      enabled: true
      cacheSystem: true
      cacheTools: true
      cacheMessages: false
  google:
    apiKey: "${GOOGLE_LLM_API_KEY}"
    model: gemini-2.5-pro
    baseURL: https://generativelanguage.googleapis.com/
    timeoutSeconds: 30
    contextCache:
      enabled: false
      # Optional existing Gemini cache resource, e.g. cachedContents/abc123.
      cachedContent: ""
      # When enabled, Manifold creates a short-lived cache for the stable
      # system/tool prefix and reuses it for matching requests in this process.
      autoCreate: false
      ttlSeconds: 3600
      cacheSystem: true
      cacheTools: true
      displayName: manifold
    extraParams: {}

# Observability.
obs:
  serviceName: manifold
  serviceVersion: 0.0.1
  environment: local
  # Optional OTLP export endpoint. Leave empty when running without an
  # OpenTelemetry Collector; the dashboard will still use local process
  # telemetry when obs.local.enabled is true.
  # Use bare host:port here. The current OTLP HTTP exporter code appends
  # the default /v1/{traces,metrics,logs} paths for collector endpoints.
  otlp: ""
  # Local process telemetry is enabled by default and backs the dashboard when
  # ClickHouse is not configured or unavailable. It is bounded and resets when
  # Manifold restarts.
  local:
    enabled: true
    metricsWindowMinutes: 60
    metricsBucketSeconds: 30
    maxLogs: 5000
    maxTraces: 1000
    maxSpansPerTrace: 256
  clickhouse:
    # Optional persistent telemetry backend. Keep CLICKHOUSE_DSN empty for a
    # self-contained install that does not run ClickHouse.
    dsn: "${CLICKHOUSE_DSN}"
    database: otel
    metricsTable: metrics_sum
    tracesTable: traces
    logsTable: logs
    timestampColumn: TimeUnix
    valueColumn: Value
    modelAttributeKey: llm.model
    promptMetricName: llm.prompt_tokens
    completionMetricName: llm.completion_tokens
    lookbackHours: 24
    timeoutSeconds: 5

# Optional authentication. Disabled by default.
auth:
  enabled: false
  # oidc | oauth2
  provider: oauth2
  issuerURL: ""
  clientID: "${AUTH_CLIENT_ID}"
  clientSecret: "${AUTH_CLIENT_SECRET}"
  redirectURL: http://localhost:32180/auth/callback
  allowedDomains: []
  cookieName: manifold_session
  cookieSecure: false
  cookieDomain: ""
  stateTTLSeconds: 600
  sessionTTLHours: 72
  oidc:
    # Optional OIDC controls. Defaults are compatible with Google/Keycloak.
    scopes:
      - openid
      - email
      - profile
    responseMode: ""
    # "" auto-detects, "params" sends client credentials in the token request body.
    tokenAuthStyle: ""
    providerName: oidc
    logoutURL: ""
    logoutRedirectParam: post_logout_redirect_uri
    apple:
      teamID: "${APPLE_TEAM_ID}"
      keyID: "${APPLE_KEY_ID}"
      privateKeyPath: "${APPLE_PRIVATE_KEY_PATH}"
      privateKey: "${APPLE_PRIVATE_KEY}"
      clientSecretTTLHours: 4320
  oauth2:
    authURL: https://github.com/login/oauth/authorize
    tokenURL: https://github.com/login/oauth/access_token
    userInfoURL: https://api.github.com/user
    logoutURL: ""
    logoutRedirectParam: redirect_uri
    scopes:
      - read:user
      - user:email
    providerName: github
    defaultRoles:
      - user
    emailField: email
    nameField: name
    pictureField: avatar_url
    subjectField: id
    rolesField: ""
    disablePKCE: false

# Database backends.
# SQLite and Postgres DB-backed specialist/MCP secrets require
# MANIFOLD_SECRETS_KEY in the process environment. Generate it once with:
#   openssl rand -base64 32
# Keep the same key after backup/restore; losing it makes encrypted DB secrets
# unrecoverable. Do not put the key in this YAML file.
databases:
  # SQLite is the default durable backend. It lets Manifold run as a single
  # binary with no DATABASE_URL. Set backend=postgres and defaultDSN below for
  # multi-host deployments or existing PostgreSQL data.
  backend: sqlite # sqlite | postgres
  sqlite:
    path: "~/.manifold/manifold.db"
    busyTimeoutMs: 10000
    wal: true
    maxOpenConns: 1
    vector:
      annEnabled: true
      annMinRows: 5000
      annRebuildChanges: 1000
      nprobe: 0.08
  defaultDSN: "" # optional Postgres DSN, e.g. ${DATABASE_URL}
  chat:
    backend: sqlite # sqlite | postgres
    dsn: ""
  search:
    backend: sqlite # sqlite | postgres
    dsn: ""
    index: documents
  vector:
    backend: sqlite # sqlite | postgres
    dsn: ""
    index: embeddings
    dimensions: 1536 # Ensure to set the correct value for your embedding model
    metric: cosine
  graph:
    backend: sqlite # sqlite | postgres
    dsn: ""

# Embedding service, used by vector features and evolving memory.
embedding:
  baseURL: https://api.openai.com
  model: text-embedding-3-small
  apiKey: "${EMBED_API_KEY}"
  apiHeader: Authorization
  headers: {}
  instructions:
    # auto applies built-in query instructions when the model looks like Qwen3
    # Embedding; enabled applies them for any model; disabled leaves queries raw.
    # Documents are embedded without instructions. Qwen3-Embedding expects
    # instruction-prefixed queries against plain documents, so no corpus
    # re-embedding is required when changing this mode.
    mode: enabled # auto | enabled | disabled
    format: qwen
    # Recommended to leave blank to use the built-in per-surface defaults.
    defaultQuery: ""
    ragQuery: ""
    evolvingMemoryQuery: ""
    transitQuery: ""
  path: /v1/embeddings
  timeoutSeconds: 30

# Optional RAG reranking service. When disabled, retrieval returns fused
# documents without calling a reranker, even if a request asks for reranking.
reranking:
  enabled: false
  baseURL: http://localhost:8203
  model: qwen3-reranker-0.6b
  # Optional query-side instruction formatted as:
  # Instruct: {instruction}
  # Query: {query}
  instruction: "Given the current task, judge whether this past experience contains a strategy, lesson, or solution that would help complete the task."
  apiKey: "${LLAMA_API_KEY}"
  apiHeader: Authorization
  headers: {}
  path: /v1/rerank
  timeoutSeconds: 30

# Optional defaults for the describe_image tool. Leave blank to use the
# invoking agent/specialist endpoint and model; per-tool-call base_url/model
# arguments still override these values.
# This is useful if you want the describe_image tool to use a local model
# with vision support. Otherwise, leave blank.
imageTool:
  baseURL: ""
  model: ""

# Unified agent memory. This is the canonical switch for evolving memory,
# belief memory, and MAGMA graph memory. Rolling chat summaries remain separate
# context management and are controlled by the summary block above.
# Can be toggled on or off per session in Chat view. Recommend to leave disabled
# and toggle per session when you want to store/retrieve memories.
# When enabled, memories retrieved are from all sessions, and not just the current session.
# Memories and lessons learned in a session will affect other memory enabled sessions.
# This is intentional.
memory:
  enabled: false
  retrieval:
    maxTokensPerPrompt: 2200
    timeoutMs: 700
    includeRecent: true
  # Dedicated clients for memory jobs. If a client is omitted, that job falls
  # back to the main llm_client. These merge over llm_client, so provider/model
  # endpoints can be overridden without repeating every shared setting.
  # Useful if you want to offload different parts of the memory systems to different
  # providers or self hosted endpoints.
  llmClients:
    evolving:
      provider: local
      openai:
        apiKey: ""
        baseURL: http://localhost:11434/v1
        model: qwen-memory
        api: completions
        extraHeaders: {}
        extraParams:
          # Local OpenAI-compatible cache flags are backend-specific. These are
          # llama.cpp-style examples and should be removed for other backends.
          cache_prompt: true
          id_slot: manifold-memory
    beliefDistillation:
      provider: openai
      openai:
        apiKey: "${OPENAI_API_KEY}"
        baseURL: https://api.openai.com/v1
        model: gpt-5-nano
        api: responses
        extraHeaders: {}
        extraParams:
          prompt_cache_key: manifold-belief
          prompt_cache_retention: in_memory
    # Used by MAGMA consolidation to extract temporal/entity/causal structure
    # from memory events. Equivalent legacy path: magma.consolidation.llmClient.
    magmaConsolidation:
      provider: openai
      openai:
        apiKey: "${OPENAI_API_KEY}"
        baseURL: https://api.openai.com/v1
        model: gpt-5-nano
        api: responses
        extraHeaders: {}
        extraParams:
          prompt_cache_key: manifold-magma
          prompt_cache_retention: in_memory
  evolving:
    # Async persistence and idle-session cleanup.
    persistDebounceMs: 250
    sessionTTLMinutes: 120
    janitorIntervalMinutes: 15
    storeJanitorIntervalMinutes: 60
    maxSize: 2000
    topK: 4
    windowSize: 20
    enableRAG: true
    # 0 disables each gate; defaults below are conservative floors for Qwen embeddings / reranker.
    retrievalSimilarityThreshold: 0.35
    minRerankScore: 0.30
    reMemEnabled: false
    maxInnerSteps: 3
    model: gpt-4o-mini
    # Smart pruning deduplicates and ages out low-relevance memories.
    enableSmartPrune: true
    pruneThreshold: 0.97
    relevanceDecay: 0.99
    minRelevance: 0.05
    pruneQualityFloor: 3
    promotionAccessThreshold: 5
  belief:
    enableDistillation: true
    enableRetrieval: true
    enableConstraintEnforcement: true
    distillation:
      mode: llm # simple | llm
      maxCandidatesPerEpisode: 5
      minCandidateConfidence: 0.55
      autoApplyMinConfidence: 0.65
    maxBeliefsPerPrompt: 5
    maxEvidencePerBelief: 3
    defaultConfidence: 0.5
    promotionThreshold: 0.8
    retrieval:
      minConfidence: 0.35
      maxTokensPerPrompt: 700
      includeContradictions: true
    lifecycle:
      minEvidenceForPromotion: 2
      maxEvidenceAgainstPromotion: 0
      staleAfterDays: 30
      staleConfidenceDecay: 0.90
      allowOrgPromotion: false
    enforcement:
      autoEnable: true
      softPolicyThreshold: 0.85
      hardConstraintThreshold: 0.95
      hardConstraintMinEvidenceFor: 3
    # Optional RAG evidence lane for belief prompts.
    enableRAGEvidence: false
    maxRAGEvidencePerPrompt: 3
    ragRetrievalK: 8
    ragMinScore: 0.0
  magma:
    consolidation:
      batchSize: 10
      maxQueueSize: 1000
      workerCount: 2
      prompts:
        consolidationExtraction: ""
        intentClassification: ""
    graphs:
      # Semantic graph stores similarity edges between memory events.
      semantic:
        enabled: true
        topK: 20
        similarityThreshold: 0.7
      # Temporal graph extracts time ordering. dateResolution can be auto or a
      # backend-specific explicit resolution.
      temporal:
        enabled: true
        dateResolution: auto
      # Causal graph relies on LLM confidence for cause/effect edges.
      causal:
        enabled: true
        llmThreshold: 0.8
      # Entity graph links mentions and optional co-reference clusters.
      entity:
        enabled: true
        coReference: true
    retrieval:
      defaultHops: 2
      defaultMaxNodes: 10
      intentClassification: hybrid
      contextFormat: structured
    lifecycle:
      pruneIntervalMinutes: 60
      eventTTLHours: 168
      maxEdgesPerSourceRel: 25
      minSemanticWeight: 0.45
      lowConfidenceThreshold: 0.65
      requireReviewApproval: false
      archiveBeforeDelete: true
      requireCausalGrounding: false

# Decision lineage and provenance memory. Disabled by default for rollout.
archaeology:
  enabled: false
  archive_before_delete: true
  decision_distiller: true
  causal_grounding_required: true
  reactor:
    confidence_floor: 0.35
    confidence_drop_delta: 0.30
  retrieval:
    max_decisions_per_prompt: 5
    max_tokens_per_prompt: 600
    timeout_ms: 0
  auto_activate:
    enabled: false
    min_confidence: 0.85
    conflict_similarity_floor: 0.50

# Shared durable memory.
transit:
  enabled: true
  defaultSearchLimit: 10
  defaultListLimit: 100
  maxBatchSize: 100
  enableVectorSearch: true

# Text to speech
tts:
  baseURL: https://api.openai.com/v1
  model: gpt-4o-mini-tts
  voice: alloy

# Speech to text
stt:
  baseURL: https://api.openai.com
  model: gpt-4o-mini-transcribe

# Experimental - Recommend to leave disabled until fully documented.
# Deterministic and LLM-assisted code quality evaluation. The service can run
# gate checks, judge diffs, and generate small candidate patches through the
# code_qa_* tools and the CodeQA UI.
codeQA:
  enabled: false
  # Relative paths are resolved under workdir; absolute paths are used as-is.
  artifactDir: codeqa-artifacts
  maxConcurrentRuns: 1
  maxGateParallelism: 2
  maxJudgeParallelism: 2
  defaultMaxDiffBytes: 131072
  defaultMaxChangedFiles: 12
  # acceptThreshold is the maximum weighted issue score that can still pass.
  acceptThreshold: 0.10
  minConfidence: 0.70
  # Leave blank to inherit llm_client.openai.model.
  judgeModel: ""
  proposerModel: ""
  # Shell commands the CodeQA runner may execute for gates and candidate checks.
  allowedCommands:
    - go
    - gofmt
    - ruff
    - pytest
    - python
    - prettier
    - eslint
    - tsc
    - npm
    - npx
    - stylelint
    - html-validate
    - cargo
    - rustfmt
  # High-risk paths are still reviewable but weighted more carefully by judges.
  highRiskGlobs:
    - "**/auth/**"
    - "**/migrations/**"
    - "**/*crypto*"
    - "**/deploy/**"
    - "**/.github/**"
  # Forbidden paths are excluded from generated candidate edits.
  forbiddenGlobs:
    - "**/*.pem"
    - "**/*.key"
    - "**/.env*"
    - "**/node_modules/**"
    - "**/dist/**"
  allowAutoApply: false
  allowCommitAccepted: false

# Accurate token counting.
tokenization:
  enabled: true
  cacheSize: 1000
  cacheTTLSeconds: 3600
  fallbackToHeuristic: true

# Optional built-in Matrix gateway.
# Allows Manifold specialists to send messages to Matrix channels.
# Leave disabled unless you host your own Matrix infra.
matrix:
  enabled: false
  homeserverURL: https://matrix.example.com
  userID: "${MATRIX_USER_ID}"
  accessToken: "${MATRIX_ACCESS_TOKEN}"
  deviceID: manifold-agentd
  # Maximum recent messages retained in memory for Matrix context. Set 0 to use
  # the gateway's default behavior.
  messageRetention: 100
  syncTimeoutSeconds: 30
  syncRetryDelaySeconds: 3
  # false skips historical backlog and only processes new events after startup.
  processBacklog: false
  rooms:
    - roomID: "!example:matrix.example.com"
      # defaultTarget is the specialist/orchestrator target used when no mention
      # route matches.
      defaultTarget: orchestrator
      allowUnmentioned: true
      mentions:
        "@razer": razer
        "@gpt": gpt
      systemPromptRef: assets/prompts/matrix/default.txt
      messageRetention: 100
      maxConcurrent: 1

# Experimental: Optional Forge-style guarded agent loop. Disabled by default.
# Can be enabled per specialist in UI regardless of this config.
harness:
  enabled: false
  # legacy | guarded_chat | workflow
  mode: guarded_chat
  # rescueEnabled lets the guarded loop ask the model to recover after a
  # failed/invalid step instead of ending the run immediately.
  rescueEnabled: true
  maxRetriesPerStep: 3
  maxToolErrors: 2
  # terminalTools are treated as final-answer tools by workflow enforcement.
  terminalTools:
    - agent_response
  # requiredSteps can enforce a minimum workflow sequence before final output.
  requiredSteps: []
  # toolPrerequisites maps a tool name to prior tool calls that must have
  # succeeded first. matchArg optionally requires matching argument values.
  toolPrerequisites:
    fetch:
      - tool: search
        matchArg: query
  compact:
    # compact controls metadata-aware run-history compaction inside the harness.
    enabled: true
    keepRecentSteps: 4
    phaseThresholds: [0.60, 0.75, 0.90]
