    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.46.4",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.0",
    "axios": "^1.18.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.16.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.25",
    "vue-router": "^4.3.2",
    "vue3-grid-layout-next": "^1.0.7"
