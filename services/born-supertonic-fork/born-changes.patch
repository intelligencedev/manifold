diff --git a/cmd/spike/main.go b/cmd/spike/main.go
new file mode 100644
index 0000000..4b736c8
--- /dev/null
+++ b/cmd/spike/main.go
@@ -0,0 +1,82 @@
+package main
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/born-ml/born/backend/cpu"
+	"github.com/born-ml/born/onnx"
+)
+
+func okOrErr(err error) string {
+	if err != nil {
+		return "FAILED: " + err.Error()
+	}
+	return "SUCCESS"
+}
+
+func main() {
+	supported := map[string]bool{}
+	for _, op := range onnx.ListSupportedOps() {
+		supported[op] = true
+	}
+	sup := onnx.ListSupportedOps()
+	sort.Strings(sup)
+	fmt.Printf("Born supports %d ops:\n%v\n\n", len(sup), sup)
+
+	// Union of op_types used across Supertonic's 4 graphs (from onnx enumeration).
+	required := []string{
+		"Add", "BatchNormalization", "Cast", "Clip", "Concat", "Constant",
+		"ConstantOfShape", "Conv", "Cos", "Div", "Equal", "Erf", "Exp", "Expand",
+		"Gather", "Gemm", "LayerNormalization", "MatMul", "Mul", "PRelu", "Pad",
+		"Pow", "Reciprocal", "ReduceSum", "Relu", "Reshape", "Shape", "Sin",
+		"Slice", "Softmax", "Softplus", "Split", "Squeeze", "Sub", "Tanh", "Tile",
+		"Transpose", "Unsqueeze", "Where",
+	}
+	var missingReq []string
+	for _, op := range required {
+		if !supported[op] {
+			missingReq = append(missingReq, op)
+		}
+	}
+	sort.Strings(missingReq)
+	fmt.Printf("Supertonic uses %d distinct ops.\n", len(required))
+	if len(missingReq) == 0 {
+		fmt.Printf("OP COVERAGE: ALL %d Supertonic ops are supported by Born.\n\n", len(required))
+	} else {
+		fmt.Printf("OP COVERAGE: %d MISSING ops: %v\n\n", len(missingReq), missingReq)
+	}
+
+	modelsDir := "../../../../models/onnx"
+	models := []string{
+		"duration_predictor.onnx",
+		"text_encoder.onnx",
+		"vector_estimator.onnx",
+		"vocoder.onnx",
+	}
+
+	for _, m := range models {
+		path := modelsDir + "/" + m
+		fmt.Printf("========== %s ==========\n", m)
+		info, err := onnx.GetModelInfo(path)
+		if err != nil {
+			fmt.Printf("  GetModelInfo ERROR: %v\n", err)
+		} else {
+			fmt.Printf("  opset=%d nodes=%d inputs=%v outputs=%v\n",
+				info.OpsetVersion, info.NodeCount, info.InputNames, info.OutputNames)
+		}
+
+		backend := cpu.New()
+
+		// Non-strict (default): skips unsupported ops silently.
+		_, errLoose := onnx.Load(path, backend)
+
+		// Strict: must fail if any op is unsupported.
+		opts := onnx.DefaultLoadOptions()
+		opts.StrictMode = true
+		_, errStrict := onnx.Load(path, backend, opts)
+
+		fmt.Printf("  LOAD (default/skip): %s\n", okOrErr(errLoose))
+		fmt.Printf("  LOAD (strict):       %s\n\n", okOrErr(errStrict))
+	}
+}
diff --git a/cmd/tts/main.go b/cmd/tts/main.go
new file mode 100644
index 0000000..fe1ae14
--- /dev/null
+++ b/cmd/tts/main.go
@@ -0,0 +1,54 @@
+// Command tts renders text to a WAV file using the pure-Go Supertonic pipeline.
+//
+//	go run ./cmd/tts -models <dir> -voice M1 -out out.wav "Hello there."
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/born-ml/born/supertonic"
+)
+
+func main() {
+	modelDir := flag.String("models", "", "model dir (onnx/ + voice_styles/)")
+	voice := flag.String("voice", "M1", "voice id")
+	lang := flag.String("lang", "en", "language")
+	steps := flag.Int("steps", 8, "flow-matching steps")
+	out := flag.String("out", "out.wav", "output wav path")
+	flag.Parse()
+
+	text := strings.Join(flag.Args(), " ")
+	if *modelDir == "" || text == "" {
+		fmt.Fprintln(os.Stderr, "usage: tts -models <dir> [-voice M1] [-out out.wav] <text>")
+		os.Exit(2)
+	}
+
+	t0 := time.Now()
+	tts, err := supertonic.New(*modelDir)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "load:", err)
+		os.Exit(1)
+	}
+	loadDur := time.Since(t0)
+	t1 := time.Now()
+	samples, err := tts.Synthesize(text, *voice, supertonic.Options{Lang: *lang, TotalSteps: *steps})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "synthesize:", err)
+		os.Exit(1)
+	}
+	synthDur := time.Since(t1)
+	audioSec := float64(len(samples)) / float64(tts.SampleRate())
+	fmt.Printf("load %.2fs | synth %.2fs for %.2fs audio | RTF %.2f\n",
+		loadDur.Seconds(), synthDur.Seconds(), audioSec, synthDur.Seconds()/audioSec)
+	wav := supertonic.WAVBytes(supertonic.FloatToPCM16(samples), tts.SampleRate())
+	if err := os.WriteFile(*out, wav, 0o644); err != nil {
+		fmt.Fprintln(os.Stderr, "write:", err)
+		os.Exit(1)
+	}
+	fmt.Printf("wrote %s: %d samples, %.2fs @ %dHz\n",
+		*out, len(samples), float64(len(samples))/float64(tts.SampleRate()), tts.SampleRate())
+}
