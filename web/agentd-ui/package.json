    "autoprefixer": "^10.4.17",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.18",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
